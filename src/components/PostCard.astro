---
import { formatDate } from '../data/site';

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      description: string;
      date: Date;
      readingTime: string;
    };
  };
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

<article class:list={['post-card', { 'post-card--featured': featured }]} data-post-card data-title={post.data.title.toLowerCase()} data-description={post.data.description.toLowerCase()}>
  <a href={`/blog/${post.id}/`}>
    <div class="post-card__meta">
      <span>{formatDate(post.data.date)} · {post.data.readingTime}</span>
    </div>
    <h3>{post.data.title}</h3>
    <p>{post.data.description}</p>
    <div class="post-card__footer">
      <span class="card-arrow" aria-hidden="true">↗</span>
    </div>
  </a>
</article>
