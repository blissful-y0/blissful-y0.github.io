---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import { profile } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  compactHeader?: boolean;
}

const {
  title = `${profile.displayName} · quiet digital work`,
  description = profile.intro,
  image = '/images/lofi-room-desktop.webp',
  compactHeader = false,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#08090d" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='10' fill='%23FFC8E0'/%3E%3Cpath d='M9 16.5 14 21l10-11' fill='none' stroke='%23262277' stroke-linecap='round' stroke-linejoin='round' stroke-width='3'/%3E%3C/svg%3E" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site ?? Astro.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body class:list={{ 'has-compact-header': compactHeader }}>
    {compactHeader && <SiteNav />}
    <slot />
    <script is:inline>
      (() => {
        const retireLegacyWorker = async () => {
          if (!('serviceWorker' in navigator)) return;
          const registrations = await navigator.serviceWorker.getRegistrations();
          const ownWorker = registrations.filter((registration) => {
            const candidate = registration.active ?? registration.waiting ?? registration.installing;
            if (!candidate) return false;
            return new URL(candidate.scriptURL).pathname === '/sw.js';
          });
          await Promise.all(ownWorker.map((registration) => registration.unregister()));
          if ('caches' in window) await caches.delete('pixyll2');
        };
        retireLegacyWorker().catch(() => {});
      })();
    </script>
  </body>
</html>
