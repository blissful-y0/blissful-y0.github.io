---
const edited = '/images/experiments/room-clean-rain-v1.png';
---
<!doctype html><html lang="ko"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex"/><title>창문 움직임 비교 · Bliss</title></head><body>
<header><a href="/">← Bliss</a><span>창문 움직임 비교</span><button id="pause" aria-pressed="false">비 멈추기</button></header>
<main><div class="controls" role="group" aria-label="배경 선택"><button data-mode="original" aria-pressed="false">원본</button><button data-mode="clean" aria-pressed="false">빗줄기 제거본</button><button data-mode="animated" aria-pressed="true">제거본 + 새 비</button></div>
<div class="scene" id="scene"><img id="plate" src={edited} alt="밤의 작업실 창밖 비 효과 비교" width="1672" height="941"/><canvas id="rain" aria-hidden="true"></canvas></div>
<p>같은 화면에서 비교하세요. 편집본은 창밖 건물과 나무 일부가 원본과 다릅니다.</p><a class="download" href={edited} download>편집본 다운로드 ↗</a></main>
<style is:global>html{color-scheme:dark;background:#141724;color:#e7e5ed;font-family:system-ui,sans-serif}body{margin:0}header{padding:22px 5%;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #ffffff18;font-size:13px}a{color:#d7bfd5;text-decoration:none}button{background:transparent;border:1px solid #a5a3b73b;border-radius:5px;color:#c4c1cf;padding:10px 14px;cursor:pointer;font:inherit}button[aria-pressed=true]{background:#364764;border-color:#678ec9;color:white}main{max-width:1500px;margin:auto;padding:24px 4%}.controls{display:flex;justify-content:center;gap:8px;margin-bottom:24px;font-size:12px}.scene{position:relative;overflow:hidden}.scene img{display:block;width:100%;height:auto}.scene canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}p{font-size:12px;color:#a9a6ba;line-height:1.8}.download{font-size:12px}button:focus-visible,a:focus-visible{outline:2px solid #ffc8e0;outline-offset:4px}@media(max-width:650px){header{font-size:11px}.controls{font-size:10px;gap:5px}.controls button{padding:10px 8px}.scene{aspect-ratio:1/1.15}.scene img{width:auto;height:100%;max-width:none;position:absolute;right:0}.scene canvas{width:auto;height:100%;aspect-ratio:1672/941;left:auto;right:0}main{padding:20px 4%}}</style>
<script>
const canvas = document.querySelector<HTMLCanvasElement>('#rain')!;
const ctx = canvas.getContext('2d')!;
canvas.width=1672;canvas.height=941;
const image = document.querySelector<HTMLImageElement>('#plate')!;
const pause = document.querySelector<HTMLButtonElement>('#pause')!;
const reduced=matchMedia('(prefers-reduced-motion: reduce)');
let paused=reduced.matches, mode='animated', last=0, frame=0;
let seed=715;
const random=()=>{seed=(seed*16807)%2147483647;return(seed-1)/2147483646;};
const drops=Array.from({length:330},()=>({x:930+random()*750,y:random()*500,depth:random(),phase:random()*6.28}));
const glass=new Path2D('M934 0H1204V317H1030V321H934Z M1242 0H1672V440H1500V313H1242Z');
function draw(now:number){frame=requestAnimationFrame(draw);if(document.hidden)return;const dt=Math.min((now-last)/1000,.04);last=now;ctx.clearRect(0,0,1672,941);if(mode!=='animated')return;ctx.save();ctx.clip(glass);
for(const d of drops){if(!paused){d.y+=dt*(30+d.depth*95);d.x-=dt*(2+d.depth*4);if(d.y>490){d.y=-30;d.x=930+random()*750;}}
const length=3+d.depth*14;const alpha=(.07+d.depth*.20)*(.75+.25*Math.sin(d.phase+d.y*.015));
ctx.lineWidth=.45+d.depth*.55;ctx.lineCap='round';const gradient=ctx.createLinearGradient(d.x,d.y,d.x-1,d.y+length);gradient.addColorStop(0,'rgba(155,179,213,0)');gradient.addColorStop(.5,`rgba(155,179,213,${alpha})`);gradient.addColorStop(1,'rgba(155,179,213,0)');ctx.strokeStyle=gradient;ctx.beginPath();ctx.moveTo(d.x,d.y);ctx.quadraticCurveTo(d.x-.6,d.y+length*.6,d.x-1,d.y+length);ctx.stroke();}
ctx.restore();}
const sync=()=>{pause.setAttribute('aria-pressed',String(paused));pause.textContent=paused?'비 재생':'비 멈추기';};
pause.addEventListener('click',()=>{paused=!paused;sync();});
reduced.addEventListener('change',()=>{paused=reduced.matches;sync();});
document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach(button=>button.addEventListener('click',()=>{mode=button.dataset.mode!;image.src=mode==='original'?'/images/lofi-room-desktop.webp':'/images/experiments/room-clean-rain-v1.png';document.querySelectorAll('[data-mode]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));}));
sync();frame=requestAnimationFrame(draw);
window.addEventListener('pagehide',()=>cancelAnimationFrame(frame));
window.addEventListener('pageshow',e=>{if(e.persisted)frame=requestAnimationFrame(draw);});
</script></body></html>
