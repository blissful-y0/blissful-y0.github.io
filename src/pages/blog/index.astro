---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/blog.css';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Journal · Bliss" description="Notes on making, learning, and quiet digital work." compactHeader>
  <main class="page-main">
    <header class="page-heading">
      <div class="page-heading__inner">
        <h1>Journal</h1>
      </div>
    </header>
    <section class="page-content" aria-label="Journal entries">
      <div class="blog-toolbar">
        <label class="search-box">
          <span aria-hidden="true">⌕</span>
          <input type="search" placeholder="Search journal" aria-label="Search journal" data-search />
        </label>
      </div>
      <div class="blog-post-grid" data-post-list>
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="pagefind-results" id="blog-results" data-pagefind-results hidden></div>
      <p class="empty-state" data-empty>No matching entries.</p>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  type PagefindRecord = {
    url?: string;
    title?: string;
    excerpt?: string;
    meta?: Record<string, string>;
  };

  type PagefindResult = {
    data: () => Promise<PagefindRecord>;
  };

  type PagefindClient = {
    init: () => Promise<void>;
    search: (query: string | null) => Promise<{ results: PagefindResult[] }>;
  };

  const searchInput = document.querySelector<HTMLInputElement>('[data-search]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-post-card]')];
  const resultList = document.querySelector<HTMLElement>('[data-pagefind-results]');
  const emptyState = document.querySelector<HTMLElement>('[data-empty]');
  let pagefind: PagefindClient | null = null;
  let pagefindPromise: Promise<PagefindClient> | null = null;
  let requestId = 0;

  const getPagefind = () => {
    if (pagefind) return Promise.resolve(pagefind);
    if (!pagefindPromise) {
      pagefindPromise = (async () => {
        const pagefindUrl = '/pagefind/pagefind.js';
        const module = await import(/* @vite-ignore */ pagefindUrl);
        const client = module as unknown as PagefindClient;
        await client.init();
        pagefind = client;
        return client;
      })().catch((error) => {
        pagefindPromise = null;
        throw error;
      });
    }
    return pagefindPromise;
  };

  const setCardVisibility = (visibleCards: HTMLElement[]) => {
    const visible = new Set(visibleCards);
    cards.forEach((card) => { card.hidden = !visible.has(card); });
    if (resultList) resultList.hidden = true;
  };

  const showPagefindResults = (records: PagefindRecord[]) => {
    if (!resultList) return;
    resultList.replaceChildren();
    const unique = records.filter((record, index, all) => record.url && all.findIndex((item) => item.url === record.url) === index);
    unique.forEach((record) => {
      const article = document.createElement('article');
      article.className = 'pagefind-result-card';
      const link = document.createElement('a');
      link.href = record.url ?? '/blog/';
      const title = document.createElement('h3');
      title.textContent = record.meta?.title ?? record.title ?? 'Journal entry';
      const excerpt = document.createElement('p');
      excerpt.className = 'pagefind-result-excerpt';
      excerpt.innerHTML = record.excerpt ?? '';
      link.append(title, excerpt);
      article.append(link);
      resultList.append(article);
    });
    resultList.hidden = unique.length === 0;
  };

  const applyLocalFallback = (query: string, expectedRequestId: number) => {
    if (expectedRequestId !== requestId) return;
    const visibleCards = cards.filter((card) => {
      const haystack = `${card.dataset.title ?? ''} ${card.dataset.description ?? ''}`;
      return !query || haystack.includes(query);
    });
    setCardVisibility(visibleCards);
    emptyState?.classList.toggle('is-visible', visibleCards.length === 0);
  };

  const updateResults = async () => {
    const currentRequestId = ++requestId;
    const query = searchInput?.value.trim().toLowerCase() ?? '';
    if (!query) {
      setCardVisibility(cards);
      emptyState?.classList.remove('is-visible');
      return;
    }

    try {
      const client = await getPagefind();
      if (currentRequestId !== requestId) return;
      const response = await client.search(query);
      if (currentRequestId !== requestId) return;
      const records = (await Promise.all(response.results.map((result) => result.data())))
        .filter((record) => record.url?.includes('/blog/') && !record.url.endsWith('/blog/'));
      if (currentRequestId !== requestId) return;
      setCardVisibility([]);
      showPagefindResults(records);
      emptyState?.classList.toggle('is-visible', records.length === 0);
    } catch {
      applyLocalFallback(query, currentRequestId);
    }
  };

  searchInput?.addEventListener('input', () => { void updateResults(); });
</script>
