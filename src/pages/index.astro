---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import CoffeeSteam from '../components/CoffeeSteam.astro';
import '../styles/home.css';
---
<BaseLayout title="Bliss — After hours" description="A space for things I build and notes I keep.">
  <main>
    <section class="room-hero" aria-label="A rainy evening at the desk">
      <div class="room-viewport">
        <div class="room-plane" data-room-plane>
          <img src="/images/lofi-room-clean.png" alt="A warmly lit desk overlooking a rainy neighborhood" width="1672" height="941" fetchpriority="high" />
          <canvas id="room-rain" class="room-effects" width="1672" height="941" aria-hidden="true"></canvas>
          <svg class="room-effects" viewBox="0 0 1672 941" aria-hidden="true">
            <CoffeeSteam x={1255} y={550} id="home-coffee-steam" />
          </svg>
        </div>
        <div class="room-shade" aria-hidden="true"></div>
        <div class="room-navigation"><SiteNav variant="hero" /></div>
        <div class="room-title"><span class="room-eyebrow">BLISS’S CORNER</span><h1>Stay a little.</h1><p>Things I build. Notes I keep.</p><a href="/blog/">Read the journal <span aria-hidden="true">↗</span></a></div>
        <div class="room-bottom"><a href="#about">Scroll to explore <span aria-hidden="true">↓</span></a><button type="button" class="motion-toggle" aria-pressed="false">Pause motion</button></div>
      </div>
    </section>
    <section class="quiet-about" id="about"><div><span class="room-eyebrow">ABOUT BLISS</span><h2>Making things.<br />Keeping notes.</h2></div><div class="quiet-links"><a href="/blog/">Journal <span>↗</span></a><a href="https://github.com/blissful-y0" target="_blank" rel="noreferrer">GitHub <span>↗</span></a></div></section>
  </main>
  <footer class="quiet-footer"><span>© 2026 Bliss</span><span>Sample content</span></footer>
</BaseLayout>
<script>
  const plane = document.querySelector<HTMLElement>('[data-room-plane]');
  const viewport = document.querySelector<HTMLElement>('.room-viewport');
  const hero = document.querySelector<HTMLElement>('.room-hero');
  const title = document.querySelector<HTMLElement>('.room-title');
  const toggle = document.querySelector<HTMLButtonElement>('.motion-toggle');
  const preference = matchMedia('(prefers-reduced-motion: reduce)');
  let paused = preference.matches;
  let frame = 0;
  function update() {
    frame = 0;
    if (!plane || !viewport || !hero) return;
    const {width, height} = viewport.getBoundingClientRect();
    const mobile = matchMedia('(max-width: 720px)').matches;
    const ratio = 1672 / 941;
    const imageWidth = Math.max(width, height * ratio);
    const imageHeight = imageWidth / ratio;
    plane.style.width = `${imageWidth}px`;
    plane.style.height = `${imageHeight}px`;
    plane.style.left = `${(width - imageWidth) / (mobile ? 1 : 2)}px`;
    plane.style.top = `${(height - imageHeight) / 2}px`;
    const progress = paused ? 0 : Math.min(1, Math.max(0, -hero.getBoundingClientRect().top / height));
    plane.style.transform = `scale(${1 + progress * .18})`;
    if (title) { title.style.transform = `translateY(${-progress * 65}px)`; title.style.opacity = String(1 - progress * .7); }
  }
  function schedule() { if (!frame) frame = requestAnimationFrame(update); }
  function sync() {
    hero?.classList.toggle('motion-paused', paused);
    toggle?.setAttribute('aria-pressed', String(paused));
    if (toggle) { toggle.disabled = preference.matches; toggle.textContent = preference.matches ? 'Reduced motion' : paused ? 'Resume motion' : 'Pause motion'; }
    schedule();
  }
  toggle?.addEventListener('click', () => { paused = !paused; sync(); });
  preference.addEventListener('change', () => { paused = preference.matches; sync(); });
  window.addEventListener('scroll', schedule, {passive:true});
  if (viewport) new ResizeObserver(schedule).observe(viewport);
  sync();
  const canvas = document.querySelector<HTMLCanvasElement>('#room-rain')!;
  const ctx = canvas.getContext('2d')!;
  let last = 0, rainFrame = 0;
let seed=715;
const random=()=>{seed=(seed*16807)%2147483647;return(seed-1)/2147483646;};
const drops=Array.from({length:700},()=>({x:930+random()*750,y:random()*500,depth:random(),phase:random()*6.28}));
const glass=new Path2D('M934 0H1204V317H1030V321H934Z M1242 0H1672V440H1500V313H1242Z');
function draw(now:number){rainFrame=requestAnimationFrame(draw);if(document.hidden)return;const dt=Math.min((now-last)/1000,.04);last=now;ctx.clearRect(0,0,1672,941);ctx.save();ctx.clip(glass);
for(const d of drops){if(!paused){d.y+=dt*(30+d.depth*95);d.x-=dt*(2+d.depth*4);if(d.y>490){d.y=-30;d.x=930+random()*750;}}
const length=6+d.depth*21;const alpha=(.14+d.depth*.36)*(.75+.25*Math.sin(d.phase+d.y*.015));
ctx.lineWidth=.65+d.depth*.8;ctx.lineCap='round';const gradient=ctx.createLinearGradient(d.x,d.y,d.x-1,d.y+length);gradient.addColorStop(0,'rgba(178,199,227,0)');gradient.addColorStop(.5,`rgba(178,199,227,${alpha})`);gradient.addColorStop(1,'rgba(178,199,227,0)');ctx.strokeStyle=gradient;ctx.beginPath();ctx.moveTo(d.x,d.y);ctx.quadraticCurveTo(d.x-.6,d.y+length*.6,d.x-1,d.y+length);ctx.stroke();}
ctx.restore();
}
  rainFrame = requestAnimationFrame(draw);
  window.addEventListener('pagehide', () => cancelAnimationFrame(rainFrame));
  window.addEventListener('pageshow', event => {
    if (event.persisted) { last = performance.now(); rainFrame = requestAnimationFrame(draw); }
  });
</script>
