---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import '../styles/home.css';
const rain = Array.from({length: 240}, (_, i) => ({x: (i * 137.7) % 1700, y: (i * 71.3) % 1900, length: 18 + (i % 4) * 8}));
---
<BaseLayout title="Bliss — 작은 작업실" description="만들고, 배우고, 기록하는 Bliss의 작은 작업실.">
  <main>
    <section class="room-hero" aria-label="비 오는 밤의 작업실">
      <div class="room-viewport">
        <div class="room-plane" data-room-plane>
          <picture><source media="(max-width: 720px)" srcset="/images/lofi-room-mobile.webp" /><img src="/images/lofi-room-desktop.webp" alt="비 오는 창밖과 따뜻한 조명이 있는 밤의 작업실" width="1672" height="941" fetchpriority="high" /></picture>
          <svg class="room-effects effects-desktop" viewBox="0 0 1672 941" aria-hidden="true">
            <defs><clipPath id="desktop-window"><path d="M932 0H1672V445H1500V310H1025V319H935Z" /></clipPath><radialGradient id="lamp-glow"><stop stop-color="#ffd5a0" stop-opacity=".19"/><stop offset="1" stop-color="#ffd5a0" stop-opacity="0"/></radialGradient></defs>
            <g clip-path="url(#desktop-window)"><g class="rain-drift">{rain.map(r => <path d={`M${r.x} ${r.y - 940}l-2 ${r.length}`} />)}{rain.map(r => <path d={`M${r.x} ${r.y}l-2 ${r.length}`} />)}</g></g>
            <ellipse class="lamp-breathe" cx="887" cy="371" rx="155" ry="160" fill="url(#lamp-glow)"/>
            <g class="cup-steam" transform="translate(1227 548)"><path d="M0 0C-12-15 12-27 0-43"/><path d="M9-2C22-17-6-31 9-50"/><path d="M-7-3C-19-18 3-30-7-47"/></g>
          </svg>
          <svg class="room-effects effects-mobile" viewBox="0 0 941 1672" aria-hidden="true">
            <defs><clipPath id="mobile-window"><path d="M386 425L614 399V764H462V782H386Z M652 398L923 358V771H870V765H652Z"/></clipPath></defs>
            <g clip-path="url(#mobile-window)"><g class="rain-drift">{rain.map(r => <path d={`M${r.x} ${r.y - 700}l-2 ${r.length}`} />)}{rain.map(r => <path d={`M${r.x} ${r.y}l-2 ${r.length}`} />)}</g></g>
            <ellipse class="lamp-breathe" cx="353" cy="814" rx="143" ry="180" fill="url(#lamp-glow)"/>
            <g class="cup-steam" transform="translate(647 984)"><path d="M0 0C-12-15 12-27 0-43"/><path d="M9-2C22-17-6-31 9-50"/><path d="M-7-3C-19-18 3-30-7-47"/></g>
          </svg>
        </div>
        <div class="room-shade" aria-hidden="true"></div>
        <div class="room-navigation"><SiteNav variant="hero" /></div>
        <div class="room-title"><span class="room-eyebrow">BLISS’S CORNER</span><h1>잠시, 쉬어가요.</h1><p>만들고, 배우고, 기록하는 작은 공간.</p><a href="/blog/">기록 읽기 <span aria-hidden="true">↗</span></a></div>
        <div class="room-bottom"><a href="#about">조금 더 아래로 <span aria-hidden="true">↓</span></a><button type="button" class="motion-toggle" aria-pressed="false">움직임 멈추기</button></div>
      </div>
    </section>
    <section class="quiet-about" id="about"><div><span class="room-eyebrow">ABOUT BLISS</span><h2>좋아하는 것을 만들고,<br />배운 것을 남깁니다.</h2></div><div class="quiet-links"><a href="/blog/">블로그 <span>↗</span></a><a href="https://github.com/blissful-y0" target="_blank" rel="noreferrer">GitHub <span>↗</span></a></div></section>
  </main>
  <footer class="quiet-footer"><span>© 2026 Bliss</span><span>소개와 글은 샘플입니다.</span></footer>
</BaseLayout>
<script>
  const plane = document.querySelector<HTMLElement>('[data-room-plane]');
  const viewport = document.querySelector<HTMLElement>('.room-viewport');
  const hero = document.querySelector<HTMLElement>('.room-hero');
  const title = document.querySelector<HTMLElement>('.room-title');
  const toggle = document.querySelector<HTMLButtonElement>('.motion-toggle');
  const preference = matchMedia('(prefers-reduced-motion: reduce)');
  let paused = preference.matches;
  let frame = 0;
  function update() {
    frame = 0;
    if (!plane || !viewport || !hero) return;
    const {width, height} = viewport.getBoundingClientRect();
    const mobile = matchMedia('(max-width: 720px)').matches;
    const ratio = mobile ? 941 / 1672 : 1672 / 941;
    const imageWidth = Math.max(width, height * ratio);
    const imageHeight = imageWidth / ratio;
    plane.style.width = `${imageWidth}px`;
    plane.style.height = `${imageHeight}px`;
    plane.style.left = `${(width - imageWidth) / 2}px`;
    plane.style.top = `${(height - imageHeight) / 2}px`;
    const progress = paused ? 0 : Math.min(1, Math.max(0, -hero.getBoundingClientRect().top / height));
    plane.style.transform = `scale(${1 + progress * .18})`;
    if (title) { title.style.transform = `translateY(${-progress * 65}px)`; title.style.opacity = String(1 - progress * .7); }
  }
  function schedule() { if (!frame) frame = requestAnimationFrame(update); }
  function sync() {
    hero?.classList.toggle('motion-paused', paused);
    toggle?.setAttribute('aria-pressed', String(paused));
    if (toggle) { toggle.disabled = preference.matches; toggle.textContent = preference.matches ? '기기 설정: 움직임 줄이기' : paused ? '움직임 켜기' : '움직임 멈추기'; }
    schedule();
  }
  toggle?.addEventListener('click', () => { paused = !paused; sync(); });
  preference.addEventListener('change', () => { paused = preference.matches; sync(); });
  window.addEventListener('scroll', schedule, {passive:true});
  if (viewport) new ResizeObserver(schedule).observe(viewport);
  sync();
</script>
