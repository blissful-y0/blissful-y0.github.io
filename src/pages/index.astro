---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
---
<BaseLayout title="Bliss" description="Bliss의 개인 공간과 기록.">
  <header class="minimal-nav"><a class="wordmark" href="/">bliss<span>®</span></a><nav aria-label="주 메뉴"><a href="#about" aria-current="page">About</a><a href="/blog/">Blog ↗</a></nav></header>
  <main>
    <section class="sculpture-scroll" aria-label="스크롤에 따라 펼쳐지는 3D 조형물">
      <div class="sculpture-stage">
        <div class="fine-grid" aria-hidden="true"></div>
        <div class="sculpture-canvas" id="sculpture" aria-hidden="true"><div class="sculpture-fallback"></div></div>
        <div class="title-lockup"><h1>Bliss.</h1><p>만들고, 배우고, 기록합니다.</p></div>
        <div class="scene-label" aria-hidden="true"><span>FIG. 001</span><span id="scene-state">PERSPECTIVE</span></div>
        <div class="scene-bottom"><span class="scroll-instruction">SCROLL TO EXPLORE <span>↓</span></span><span class="coordinate" aria-hidden="true">[ <span id="scene-progress">000</span> — 100 ]</span></div>
        <div class="scroll-meter" aria-hidden="true"><i></i></div>
      </div>
    </section>
    <section class="compact-about" id="about">
      <div><span class="tiny-label">ABOUT ME</span><h2>호기심을<br />만드는 쪽으로.</h2></div>
      <div class="about-links"><p>Bliss의 작은 실험과 기록.</p><a href="/blog/">글 읽기 <span>↗</span></a><a href="https://github.com/blissful-y0" target="_blank" rel="noreferrer">GitHub <span>↗</span></a></div>
    </section>
  </main>
  <footer class="minimal-footer"><span>© 2026 BLISS</span><span>소개와 글은 샘플입니다.</span><span>END OF PAGE ↗</span></footer>
</BaseLayout>
<script>
  import { initSculpture } from '../scripts/sculpture';
  initSculpture();
</script>
